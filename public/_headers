# katoa.org — Cloudflare Pages _headers

# HTML shell — always revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  Cache-Control: public, max-age=0, must-revalidate

# Security headers — all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://analytics.giveabit.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://analytics.giveabit.io https://*.supabase.co wss://*.supabase.co https://api.coingecko.com https://api.coinbase.com https://api.btcmap.org https://chart.googleapis.com wss://relay.damus.io wss://relay.nostr.band wss://nos.lol wss://relay.snort.social wss://nostr.wine https:; frame-src 'self' https:; frame-ancestors 'none'; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/offline.html
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400

# Hashed Vite assets — long cache. Do NOT force Content-Type here:
# overriding MIME on SPA/404 fallbacks let CF cache HTML as JS/CSS (Origin-keyed).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  # Avoid CORS/Origin cache variants of hashed files (same-origin app only)
  Access-Control-Allow-Origin: https://katoa.org
  Cross-Origin-Resource-Policy: same-origin

# Plain-text asset 404 — never labeled as JS/CSS
/asset-404.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-store

# Cache images 1 year
*.png
  Cache-Control: public, max-age=31536000, immutable
*.jpg
  Cache-Control: public, max-age=31536000, immutable
*.svg
  Cache-Control: public, max-age=31536000, immutable
*.ico
  Cache-Control: public, max-age=31536000, immutable
