# katoa.org — Cloudflare Pages _headers

# Security headers — all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src https:; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Content-Type for CSS
/assets/*.css
  Content-Type: text/css

# Content-Type for JS
/assets/*.js
  Content-Type: application/javascript

# Cache static assets 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images 1 year
*.png
  Cache-Control: public, max-age=31536000, immutable
*.jpg
  Cache-Control: public, max-age=31536000, immutable
*.svg
  Cache-Control: public, max-age=31536000, immutable
*.ico
  Cache-Control: public, max-age=31536000, immutable
