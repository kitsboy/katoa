# katoa.org — Cloudflare Pages _headers

# HTML shell — always revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  Cache-Control: public, max-age=0, must-revalidate

# Security headers — all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.coingecko.com https://api.coinbase.com https://api.btcmap.org https://chart.googleapis.com wss://relay.damus.io wss://relay.nostr.band wss://nos.lol wss://relay.snort.social wss://nostr.wine https:; frame-src 'self' https:; frame-ancestors 'none'; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/offline.html
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400

# Content-Type for CSS
/assets/*.css
  Content-Type: text/css

# Content-Type for JS
/assets/*.js
  Content-Type: application/javascript

# Cache static assets 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images 1 year
*.png
  Cache-Control: public, max-age=31536000, immutable
*.jpg
  Cache-Control: public, max-age=31536000, immutable
*.svg
  Cache-Control: public, max-age=31536000, immutable
*.ico
  Cache-Control: public, max-age=31536000, immutable
