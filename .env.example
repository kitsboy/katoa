# Supabase Configuration (Required) — copy to .env.local
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use publishable/anon key, NOT service_role / secret
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Server-only — put in .env.server.local, NEVER in VITE_* or Cloudflare Pages:
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# BTCPay Server Configuration (Optional - public store info only)
# API keys and webhook secrets belong in Edge Function / server env — NEVER VITE_*
VITE_BTCPAY_SERVER_URL=https://your-btcpay-instance.com
VITE_BTCPAY_STORE_ID=your-store-id
# BTCPAY_API_KEY=...          # server only
# BTCPAY_WEBHOOK_SECRET=...   # server only

# BTC Map (https://github.com/teambtcmap/btcmap.org)
VITE_BTCMAP_ENABLED=true
VITE_BTCMAP_API_URL=https://api.btcmap.org
VITE_BTCMAP_APP_URL=https://btcmap.org
# Local btcmap-api: VITE_BTCMAP_API_URL=/btcmap-api-proxy

# Demo login on /auth when Supabase is not configured (optional force: true)
# VITE_DEMO_MODE=true

# Staged API gateway (Edge Functions / Cloudflare Worker)
VITE_API_BASE_URL=

# Video uploads — max file size in MB (client-side validation; default 200)
VIDEO_MAX_MB=200

# Satohash (Bitcoin OTS timestamps — Give A Bit family)
# VITE_SATOHASH_API_URL=https://api.satohash.io
# VITE_SATOHASH_URL=https://satohash.io
# Optional family free-tier key (server FAMILY_API_KEYS) — do not commit real keys
# VITE_SATOHASH_KEY=

# Other Configuration (Optional)
VITE_APP_NAME=KATOA
VITE_APP_URL=https://katoa.org
VITE_SITE_URL=https://katoa.org
