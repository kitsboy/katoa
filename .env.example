# Supabase Configuration (Required) — copy to .env.local
# Katoa project ref: pglqjtipbocjnqmiwmwf
VITE_SUPABASE_URL=https://pglqjtipbocjnqmiwmwf.supabase.co
# Use publishable key (sb_publishable_*), NOT secret (sb_secret_*)
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Server-only — put in .env.server.local, NEVER in VITE_* or Cloudflare Pages:
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# BTCPay Server Configuration (Optional - for Bitcoin payments)
VITE_BTCPAY_SERVER_URL=https://your-btcpay-instance.com
VITE_BTCPAY_STORE_ID=your-store-id
VITE_BTCPAY_API_KEY=your-api-key
VITE_BTCPAY_WEBHOOK_SECRET=your-webhook-secret

# BTC Map (https://github.com/teambtcmap/btcmap.org)
VITE_BTCMAP_ENABLED=true
VITE_BTCMAP_API_URL=https://api.btcmap.org
VITE_BTCMAP_APP_URL=https://btcmap.org
# Local btcmap-api: VITE_BTCMAP_API_URL=/btcmap-api-proxy

# Demo login on /auth when Supabase is not configured (optional force: true)
# VITE_DEMO_MODE=true

# Staged API gateway (Edge Functions / Cloudflare Worker)
VITE_API_BASE_URL=

# Other Configuration (Optional)
VITE_APP_NAME=KATOA
VITE_APP_URL=https://katoa.org
VITE_SITE_URL=https://katoa.org
